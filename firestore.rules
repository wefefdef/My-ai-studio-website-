rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /trades/{tradeId} {
      allow read, write: if true;
    }

    match /payment_methods/{methodId} {
      allow read, write: if true;
    }
  }
}
